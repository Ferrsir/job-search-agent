<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ user_profile.site_title }}</title>
    <link rel="icon" href="assets/logo-comet-icon-1024.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
    <style>
      /* ============================================================================
         redesign-site.css — Simone's Career Center, WARM LIGHT "DATA-ROOM"
         Re-skin for templates/weekly_digest.html.j2.

         IMPORTANT: this targets the EXACT class names + DOM structure the existing
         template and its embedded JS already use (.job-card[data-job-id], .feedback,
         .quick-filter, .tab-panel, .analytics-module, .bar-fill, .geo-map, etc.).
         No markup or JS contract changes — only the look flips from espresso-dark to
         warm-paper-light, Dealroom-inspired (structure, not its blue skin).

         Tokens are inlined (the generated site is self-contained). Mirrors
         paper-theme.css. Coral stays the signature; dark survives only as the
         inset map panel + the digest email.
         ========================================================================== */
      :root {
        color-scheme: light;

        /* warm paper neutrals */
        --paper-0:  oklch(0.928 0.010 82);
        --paper-50: oklch(0.957 0.008 83);
        --paper-100:oklch(0.974 0.006 84);
        --paper-200:oklch(0.994 0.003 85);

        /* espresso ink text */
        --ink-900: oklch(0.225 0.013 56);
        --ink-700: oklch(0.355 0.013 56);
        --ink-500: oklch(0.500 0.012 58);
        --ink-400: oklch(0.610 0.011 60);
        --ink-300: oklch(0.720 0.010 64);

        /* coral — signature */
        --coral-300: oklch(0.815 0.105 28);
        --coral-400: oklch(0.745 0.145 25);
        --coral-500: oklch(0.660 0.165 24);
        --coral-600: oklch(0.585 0.165 23);
        --coral-tint:   oklch(0.745 0.145 25 / 0.10);
        --coral-tint-2: oklch(0.745 0.145 25 / 0.20);

        /* teal / lime / grape accents */
        --teal-500: oklch(0.640 0.105 199);
        --teal-600: oklch(0.545 0.095 201);
        --teal-tint: oklch(0.640 0.105 199 / 0.12);
        --lime-600: oklch(0.62 0.145 124);
        --lime-tint: oklch(0.83 0.18 118 / 0.20);

        /* match ramp (semantic only) */
        --match-poor:   oklch(0.585 0.205 27);
        --match-ok:     oklch(0.640 0.150 62);
        --match-good:   oklch(0.595 0.130 145);
        --match-strong: oklch(0.560 0.130 152);
        --match-strong-tint: oklch(0.560 0.130 152 / 0.13);

        /* borders */
        --line-soft:   oklch(0.30 0.01 60 / 0.07);
        --line:        oklch(0.30 0.01 60 / 0.13);
        --line-strong: oklch(0.30 0.01 60 / 0.20);

        /* semantic surfaces / text */
        --bg:        var(--paper-50);
        --bg-recess: var(--paper-0);
        --surface:   var(--paper-200);
        --surface-2: var(--paper-100);
        --fg:        var(--ink-900);
        --fg-muted:  var(--ink-700);
        --fg-subtle: var(--ink-500);
        --fg-faint:  var(--ink-400);
        --fg-on-coral: oklch(0.985 0.006 80);

        /* legacy template aliases (kept so any inline refs still resolve) */
        --cream-100: var(--ink-900);
        --cream-300: var(--ink-700);
        --cream-400: var(--ink-500);
        --cream-500: var(--ink-500);
        --cream-700: var(--ink-400);
        --coral: var(--coral-500);
        --teal: var(--teal-600);
        --cyan: var(--teal-600);
        --lime: var(--lime-600);
        --green: var(--match-strong);

        /* type */
        --font-display: "Bricolage Grotesque", "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
        --font-serif: Newsreader, Georgia, "Times New Roman", serif;
        --font-sans: "Hanken Grotesk", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;

        --r-sm: 10px; --r-md: 14px; --r-lg: 20px;
        --shadow-xs: 0 1px 2px oklch(0.3 0.02 60 / 0.06);
        --shadow-sm: 0 1px 3px oklch(0.3 0.02 60 / 0.08), 0 1px 2px oklch(0.3 0.02 60 / 0.04);
        --shadow-md: 0 6px 18px oklch(0.3 0.02 60 / 0.09), 0 2px 6px oklch(0.3 0.02 60 / 0.05);
        --shadow-lg: 0 20px 48px oklch(0.3 0.02 60 / 0.14);
        --shadow-pop: 4px 4px 0 0 var(--coral-500);
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --dur-fast: 120ms; --dur: 200ms; --dur-slow: 360ms;
      }

      * { box-sizing: border-box; }
      html { overflow-x: hidden; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-sans);
        line-height: 1.5;
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      button, input, select, textarea { font: inherit; }
      button { cursor: pointer; }

      /* ---------------------------------------------------------------- top bar */
      .topbar {
        align-items: center;
        background: oklch(0.974 0.006 84 / 0.85);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        display: grid;
        gap: 18px;
        grid-template-columns: auto minmax(280px, 1fr) minmax(280px, 460px) auto;
        min-height: 64px;
        padding: 10px 30px;
        position: sticky;
        top: 0;
        z-index: 5;
      }
      .brand { align-items: center; display: grid; gap: 11px; grid-template-columns: 36px auto; }
      .brand-mark { display: block; height: 36px; width: 36px; object-fit: contain; }
      .wordmark { display: grid; line-height: 1; }
      .wordmark strong { font-family: var(--font-serif); font-size: 22px; font-weight: 500; letter-spacing: -0.01em; color: var(--fg); }
      .wordmark span { color: var(--fg-subtle); font-family: var(--font-mono); font-size: 9.5px; font-weight: 600; letter-spacing: 0.28em; margin-top: 5px; text-transform: uppercase; }

      /* primary nav — horizontal tab rail, data-room style */
      .nav-tabs { display: flex; gap: 4px; }
      .nav-tabs button {
        background: transparent; border: 1px solid transparent; border-radius: 9px;
        color: var(--fg-subtle); font-family: var(--font-sans); font-weight: 700; font-size: 13.5px;
        min-height: 38px; padding: 0 14px; transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
      }
      .nav-tabs button:hover { color: var(--fg); background: var(--coral-tint); }
      .nav-tabs button.active { background: var(--coral-tint); color: var(--coral-600); }

      .search {
        align-items: center; background: var(--surface); border: 1px solid var(--line);
        border-radius: 10px; display: grid; gap: 10px; grid-template-columns: 18px minmax(0, 1fr);
        min-height: 42px; padding: 0 14px; width: 100%; transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
      }
      .search:focus-within { border-color: var(--coral-tint-2); box-shadow: 0 0 0 3px var(--coral-tint); }
      .search svg { color: var(--fg-faint); }
      .search input { background: transparent; border: 0; color: var(--fg); font-size: 14px; min-width: 0; outline: 0; }
      .search input::placeholder { color: var(--fg-faint); }

      .avatar {
        background: var(--teal-tint); border: 1px solid color-mix(in oklab, var(--teal-600) 32%, transparent);
        border-radius: 999px; color: var(--teal-600); display: grid; font-family: var(--font-serif);
        font-size: 18px; font-weight: 600; height: 40px; place-items: center; width: 40px;
      }

      /* ---------------------------------------------------------------- shell */
      .app-shell {
        align-items: start; display: grid; gap: 26px;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 320px);
        margin: 0 auto; max-width: 1640px; padding: 26px 30px 64px;
      }
      .main-column { min-width: 0; }

      /* breadcrumb-ish section heads share .caps */
      .caps {
        color: var(--fg-subtle); font-family: var(--font-mono); font-size: 11px; font-weight: 600;
        letter-spacing: 0.14em; text-transform: uppercase;
      }

      /* ---------------------------------------------------------------- hero */
      .hero-card {
        background:
          radial-gradient(120% 140% at 88% -20%, var(--coral-tint), transparent 52%),
          var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-sm);
        display: grid; gap: 22px;
        grid-template-columns: minmax(0, 1.5fr) minmax(250px, 0.7fr);
        overflow: hidden; padding: 26px 28px; position: relative;
      }
      .hero-logo { height: 124px; opacity: 0.05; pointer-events: none; position: absolute; right: 8px; top: -18px; width: 124px; }
      .hero-kicker {
        background: var(--coral-tint); border: 1px solid var(--coral-tint-2); border-radius: 999px;
        color: var(--coral-600); display: inline-flex; font-size: 11px; padding: 6px 13px; width: fit-content;
      }
      h1 {
        font-family: var(--font-display); font-size: clamp(30px, 3vw, 42px); font-weight: 800;
        letter-spacing: -0.035em; line-height: 1; margin: 14px 0 10px; max-width: 620px; color: var(--fg);
      }
      .coral-dot { color: var(--coral-500); }
      .hero-copy { color: var(--fg-muted); font-size: clamp(15px, 1.1vw, 17px); line-height: 1.5; margin: 0; max-width: 720px; }
      .hero-copy em { color: var(--fg); font-family: var(--font-serif); font-style: italic; }

      .stat-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
      .stat-chip { background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: var(--r-md); min-width: 120px; padding: 12px 14px; }
      .stat-chip strong { color: var(--coral-500); display: block; font-family: var(--font-display); font-size: 26px; font-weight: 800; line-height: 1; }
      .stat-chip:nth-child(2) strong { color: var(--lime-600); }
      .stat-chip:nth-child(3) strong { color: var(--teal-600); }
      .stat-chip .caps { display: block; margin-top: 7px; }

      .signal-board { align-content: start; display: grid; gap: 9px; position: relative; z-index: 1; }
      .signal-card { background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: var(--r-md); display: grid; gap: 5px; padding: 12px 13px; }
      .signal-card strong { color: var(--fg); font-family: var(--font-display); font-size: 15px; font-weight: 700; line-height: 1.12; }
      .signal-card span { color: var(--fg-subtle); font-size: 12px; }
      .signal-card:first-child { border-color: var(--coral-tint-2); background: var(--coral-tint); }

      /* ---------------------------------------------------------------- filters */
      .filters { display: flex; flex-wrap: nowrap; gap: 8px; margin: 22px 0 14px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
      .quick-filter {
        background: var(--surface); border: 1.5px solid var(--line); border-radius: 999px; color: var(--fg-muted);
        font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
        min-height: 34px; padding: 0 14px; text-transform: uppercase; white-space: nowrap;
        transition: all var(--dur) var(--ease-out);
      }
      .quick-filter:hover { border-color: var(--coral-tint-2); color: var(--coral-600); }
      .quick-filter.active { background: var(--coral-400); border-color: var(--coral-400); color: var(--fg-on-coral); }

      .utility-controls { display: grid; gap: 10px; grid-template-columns: repeat(3, minmax(160px, 1fr)); margin-bottom: 16px; }
      .control { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-sm); display: grid; gap: 6px; padding: 9px 13px; }
      .control label, .control span { color: var(--fg-subtle); font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
      .control select, .control input { background: transparent; border: 0; color: var(--fg); outline: 0; width: 100%; }
      .control input[type="range"] { accent-color: var(--coral-500); }

      /* ---------------------------------------------------------------- tabs/panels */
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }
      .tab-panel.is-empty .empty-state { display: grid; }
      .tab-panel:not(.is-empty) .empty-state { display: none; }
      .section-head { align-items: end; display: flex; justify-content: space-between; margin: 0 0 14px; }
      h2 { color: var(--fg); font-family: var(--font-display); font-size: 23px; font-weight: 800; letter-spacing: -0.025em; margin: 0; }

      /* ---------------------------------------------------------------- role rows
         Dense "database row" treatment — the Dealroom table feel, built on the
         existing .job-card grid so the JS (.job-card[data-job-id]) is untouched. */
      .role-list { display: grid; gap: 8px; }
      .job-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md);
        display: grid; gap: 16px; grid-template-columns: 44px minmax(0, 1fr) minmax(150px, auto);
        padding: 16px 18px; position: relative; transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
      }
      .job-card:hover { border-color: var(--coral-tint-2); box-shadow: var(--shadow-md); transform: translateY(-1px); }
      .job-card.featured { background: var(--surface); border: 1.5px solid var(--coral-400); box-shadow: var(--shadow-pop); }
      .job-card.is-hidden { display: none; }

      .company-tile {
        align-items: center; background: var(--coral-tint); border: 1px solid var(--coral-tint-2);
        border-radius: 10px; color: var(--coral-600); display: grid; font-family: var(--font-display);
        font-size: 19px; font-weight: 800; height: 44px; justify-items: center; text-transform: uppercase; width: 44px;
      }
      .card-label { align-items: center; color: var(--fg-subtle); display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 7px; }
      .top-badge { background: var(--coral-400); border-radius: 7px; color: var(--fg-on-coral); display: inline-flex; padding: 5px 9px; font-size: 11px; }
      .role-link { color: var(--fg); display: inline-block; font-family: var(--font-sans); font-size: clamp(17px, 1.3vw, 20px); font-weight: 700; line-height: 1.12; letter-spacing: -0.01em; }
      .role-link:hover { color: var(--coral-600); }
      .meta { color: var(--fg-subtle); display: flex; flex-wrap: wrap; font-size: 14px; gap: 7px; margin-top: 5px; }
      .meta strong { color: var(--coral-600); font-weight: 700; }

      .why { color: var(--fg-muted); display: -webkit-box; font-size: 14.5px; line-height: 1.5; margin: 12px 0 10px; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
      .requirements { border-left: 2px solid var(--teal-500); color: var(--fg-muted); display: -webkit-box; font-size: 13.5px; line-height: 1.45; margin: -2px 0 12px; overflow: hidden; padding-left: 12px; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
      .requirements strong { color: var(--fg); display: block; font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; margin-bottom: 4px; text-transform: uppercase; }

      .network { background: var(--teal-tint); border: 1px solid color-mix(in oklab, var(--teal-600) 24%, transparent); border-radius: var(--r-md); color: var(--fg-muted); display: grid; font-size: 13px; gap: 9px; line-height: 1.45; margin: -2px 0 12px; padding: 11px 12px; }
      .network > span { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
      .network strong { color: var(--teal-600); display: block; font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
      .network-list { display: flex; flex-wrap: wrap; gap: 7px; max-height: 33px; overflow: hidden; }
      .network-contact:nth-child(n + 4) { display: none; }
      .network-contact { background: var(--surface); border: 1px solid var(--line); border-radius: 999px; color: var(--fg-muted); padding: 6px 10px; font-size: 12px; }
      .network-contact a { color: var(--teal-600); font-weight: 700; }

      /* two-tier tags: outline keyword chips (matches Dealroom's lower tag row) */
      .tag-row { display: flex; flex-wrap: wrap; gap: 7px; }
      .tag {
        background: var(--surface); border: 1px solid var(--line); border-radius: 7px; color: var(--fg-muted);
        font-family: var(--font-sans); font-size: 12px; font-weight: 600; letter-spacing: 0; padding: 5px 9px; text-transform: none;
      }

      /* match indicator (the score pill -> data-room match chip) */
      .score-pill {
        align-items: center; background: var(--match-strong-tint); border: 1px solid color-mix(in oklab, var(--match-strong) 32%, transparent);
        border-radius: 7px; color: var(--match-strong); display: inline-flex; font-family: var(--font-mono);
        font-size: 12px; font-weight: 700; letter-spacing: 0.02em; padding: 7px 9px; white-space: nowrap;
      }

      .feedback-box { align-content: start; display: grid; gap: 7px; justify-items: end; }
      .feedback {
        background: var(--surface); border: 1px solid var(--line); border-radius: 999px; color: var(--fg-muted);
        font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; min-height: 32px;
        padding: 0 12px; text-transform: uppercase; transition: all var(--dur-fast) var(--ease-out);
      }
      .feedback:hover { border-color: var(--coral-tint-2); color: var(--coral-600); }
      .feedback.active[data-feedback="shortlist"] { background: var(--lime-600); border-color: var(--lime-600); color: var(--paper-200); }
      .feedback.active[data-feedback="direction"] { background: var(--teal-600); border-color: var(--teal-600); color: var(--paper-200); }
      .feedback.active[data-feedback="wrong"] { background: var(--coral-500); border-color: var(--coral-500); color: var(--paper-200); }

      .reason-panel { background: var(--coral-tint); border: 1px solid var(--coral-tint-2); border-radius: var(--r-sm); display: none; gap: 8px; justify-items: stretch; padding: 11px; width: min(230px, 100%); }
      .direction-reasons { background: var(--teal-tint); border-color: color-mix(in oklab, var(--teal-600) 24%, transparent); }
      .reason-panel.is-open { display: grid; }
      .reason-panel-title { color: var(--fg-subtle); font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
      .reason-option { align-items: center; color: var(--fg-muted); display: grid; font-size: 12px; font-weight: 600; gap: 8px; grid-template-columns: 15px minmax(0, 1fr); line-height: 1.2; }
      .reason-option input { accent-color: var(--coral-500); height: 15px; margin: 0; width: 15px; }
      .direction-reasons .reason-option input { accent-color: var(--teal-600); }
      .reason-submit { background: var(--coral-500); border: 1px solid var(--coral-500); border-radius: 999px; color: var(--paper-200); font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; min-height: 32px; padding: 0 12px; text-transform: uppercase; }
      .direction-reasons .reason-submit { background: var(--teal-600); border-color: var(--teal-600); }
      .reason-submit:disabled { background: var(--surface-2); border-color: var(--line); color: var(--fg-faint); cursor: not-allowed; }

      .packet-button { background: var(--ink-900); border: 1px solid var(--ink-900); border-radius: 999px; color: var(--paper-200); font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; min-height: 36px; padding: 0 13px; text-transform: uppercase; transition: background var(--dur) var(--ease-out); }
      .packet-button:hover { background: oklch(0.285 0.013 56); }

      /* ---------------------------------------------------------------- right rail */
      .right-rail { align-content: start; display: grid; gap: 14px; position: sticky; top: 86px; }
      .side-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--shadow-xs); padding: 18px; }
      .profile-card { align-items: center; display: grid; gap: 13px; grid-template-columns: 54px 1fr; }
      .profile-avatar { background: var(--coral-tint); border: 2px solid var(--coral-tint-2); border-radius: 999px; height: 54px; object-fit: contain; padding: 6px; width: 54px; }
      .side-card h3 { color: var(--fg); font-family: var(--font-display); font-size: 18px; font-weight: 800; margin: 0 0 5px; }
      .side-card p { color: var(--fg-subtle); font-size: 13.5px; margin: 0; }
      .open-chip { background: var(--lime-tint); border-radius: 999px; color: var(--lime-600); display: inline-flex; font-family: var(--font-mono); font-size: 11px; font-weight: 700; gap: 8px; grid-column: 1 / -1; letter-spacing: 0.1em; padding: 8px 12px; text-transform: uppercase; width: fit-content; align-items: center; }
      .open-chip::before { background: var(--lime-600); border-radius: 999px; content: ""; height: 8px; width: 8px; }
      .saved-card { align-items: center; display: flex; justify-content: space-between; }
      .saved-card strong { color: var(--fg); font-family: var(--font-display); font-size: 18px; font-weight: 800; }
      .count-bubble { background: var(--coral-400); border-radius: 999px; color: var(--fg-on-coral); display: grid; font-weight: 800; height: 38px; place-items: center; width: 38px; }
      .look-list { display: grid; gap: 11px; margin: 18px 0 16px; }
      .look-item { align-items: center; color: var(--fg-muted); display: grid; gap: 12px; grid-template-columns: 32px 1fr; font-size: 14px; }
      .look-icon { background: var(--coral-tint); border-radius: 9px; color: var(--coral-600); display: grid; font-family: var(--font-mono); font-size: 12px; font-weight: 700; height: 32px; place-items: center; width: 32px; }
      .look-item:nth-child(2) .look-icon { background: var(--teal-tint); color: var(--teal-600); }
      .look-item:nth-child(3) .look-icon { background: var(--lime-tint); color: var(--lime-600); }
      .rail-button, .action-button {
        background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--fg);
        display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-sans); font-weight: 700;
        font-size: 13.5px; min-height: 42px; padding: 0 16px; text-align: center; width: 100%; transition: all var(--dur) var(--ease-out);
      }
      .rail-button:hover, .action-button:hover { border-color: var(--coral-tint-2); background: var(--coral-tint); color: var(--coral-600); }
      .action-row { display: flex; gap: 10px; margin-top: 18px; }
      .pipeline-note { border-top: 1px solid var(--line); color: var(--fg-subtle); font-size: 14px; margin-top: 24px; padding-top: 22px; }
      .right-rail > section > .caps { display: block; margin-bottom: 4px; }

      /* ---------------------------------------------------------------- modal */
      .modal { background: oklch(0.225 0.013 56 / 0.45); bottom: 0; display: none; left: 0; padding: 24px; position: fixed; right: 0; top: 0; z-index: 20; }
      .modal.is-open { display: grid; place-items: center; }
      .modal-panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-lg); max-height: 88vh; max-width: 780px; overflow: auto; padding: 28px; width: min(780px, 100%); }
      .modal-panel h2 { margin-bottom: 4px; }
      .modal-panel p { color: var(--fg-subtle); font-size: 14px; }
      .packet-output { background: var(--bg-recess); border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--fg-muted); font-family: var(--font-mono); font-size: 12.5px; line-height: 1.55; margin: 14px 0 0; min-height: 120px; overflow: auto; padding: 16px; white-space: pre-wrap; width: 100%; }
      .prefs-grid { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .prefs-grid label { color: var(--fg-subtle); display: grid; font-family: var(--font-mono); font-size: 11px; font-weight: 600; gap: 7px; letter-spacing: 0.06em; text-transform: uppercase; }
      .prefs-grid input, .prefs-grid textarea { background: var(--bg-recess); border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--fg); min-height: 42px; padding: 10px 12px; }

      /* ---------------------------------------------------------------- analytics */
      .analytics-dashboard { display: grid; gap: 18px; }
      .analytics-grid { display: grid; gap: 18px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .analytics-module { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); padding: 22px; overflow: hidden; }
      .map-module { grid-column: 1 / -1; }
      .analytics-module h3 { color: var(--fg); font-family: var(--font-display); font-size: 19px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 4px; }
      .analytics-module > .caps { display: block; margin-bottom: 14px; }
      .analytics-subgrid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
      .analytics-kpis { display: grid; gap: 12px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .analytics-kpi { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--shadow-xs); padding: 18px; }
      .analytics-kpi strong { color: var(--coral-500); display: block; font-family: var(--font-display); font-size: 32px; font-weight: 800; line-height: 1; }
      .analytics-kpi span { color: var(--fg-subtle); display: block; margin-top: 7px; }
      .analytics-toolbar { align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); display: flex; flex-wrap: wrap; gap: 10px; padding: 14px; }
      .analytics-toolbar strong { color: var(--fg); font-family: var(--font-display); font-size: 18px; font-weight: 800; margin-right: auto; }
      .analytics-filter-chip { background: var(--coral-tint); border: 1px solid var(--coral-tint-2); border-radius: 999px; color: var(--coral-600); display: none; font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; padding: 8px 12px; text-transform: uppercase; }
      .analytics-filter-chip.is-visible { display: inline-flex; }
      .analytics-clear { background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px; color: var(--fg-muted); cursor: pointer; font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; padding: 8px 12px; text-transform: uppercase; }
      .analytics-clear:hover { border-color: var(--coral-tint-2); color: var(--coral-600); }

      /* geo map stays a dark inset "ink island" panel — JS sets dark fills */
      .geo-map { aspect-ratio: 16 / 9; background: oklch(0.205 0.013 56); border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; margin-top: 14px; min-height: 320px; position: relative; }
      .geo-map-loading { align-items: center; color: oklch(0.655 0.016 66); display: flex; font-family: var(--font-mono); font-size: 12px; inset: 0; justify-content: center; letter-spacing: 0.16em; position: absolute; text-transform: uppercase; }
      .us-map-svg {
        display: block;
        height: 100%;
        width: 100%;
      }
      .geo-dot { fill: var(--coral-400); transition: fill 160ms ease, r 160ms ease; }
      .geo-halo { fill: oklch(0.745 0.145 25 / 0.22); }
      .geo-label { fill: oklch(0.955 0.013 78); font-family: var(--font-mono); font-size: 9px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; pointer-events: none; }
      .geo-label-bg { fill: oklch(0.245 0.014 56 / 0.92); stroke: oklch(1 0 0 / 0.16); stroke-width: 1; }
      .city-marker { cursor: pointer; outline: none; }
      .city-marker:hover .geo-dot, .city-marker.active .geo-dot { fill: var(--lime-500, oklch(0.83 0.18 118)); }
      .city-marker:hover .geo-label-bg, .city-marker.active .geo-label-bg { fill: oklch(0.745 0.145 25 / 0.30); stroke: oklch(0.745 0.145 25 / 0.7); }
      .city-detail { background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-md); display: grid; gap: 10px; margin-top: 14px; padding: 16px; }
      .city-detail h4 { color: var(--fg); font-family: var(--font-display); font-size: 21px; font-weight: 800; margin: 0; }
      .city-role-list { display: grid; gap: 9px; margin: 0; padding: 0; }
      .city-role-list li { align-items: baseline; border-top: 1px solid var(--line-soft); display: grid; gap: 6px; grid-template-columns: 42px minmax(0, 1fr); list-style: none; padding-top: 9px; }
      .city-score { color: var(--teal-600); font-family: var(--font-mono); font-size: 12px; font-weight: 700; }
      .city-role-list a { color: var(--fg); font-weight: 700; }
      .city-role-list a:hover { color: var(--coral-600); }
      .city-role-list span { color: var(--fg-subtle); display: block; font-size: 13px; }

      .stack-list { display: grid; gap: 16px; }
      .stack-row { display: grid; gap: 8px; }
      .stack-row-head { align-items: baseline; display: flex; justify-content: space-between; }
      .stack-label { color: var(--fg); font-weight: 700; }
      .stack-track { background: var(--paper-0); border: 1px solid var(--line-soft); border-radius: 999px; display: flex; height: 13px; overflow: hidden; }
      .stack-segment { background: var(--segment-color); min-width: 2px; }
      .legend { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-top: 14px; }
      .legend span { align-items: center; color: var(--fg-subtle); display: inline-flex; font-family: var(--font-mono); font-size: 11px; gap: 6px; letter-spacing: 0.04em; text-transform: uppercase; }
      .legend i { background: var(--legend-color); border-radius: 3px; height: 9px; width: 9px; }

      .chip-cloud { display: flex; flex-wrap: wrap; gap: 9px; }
      .metric-chip { background: var(--surface); border: 1px solid var(--line); border-radius: 999px; color: var(--fg); display: inline-flex; font-family: var(--font-sans); font-weight: 700; font-size: 13px; gap: 9px; padding: 9px 13px; }
      button.metric-chip { cursor: pointer; transition: all var(--dur) var(--ease-out); }
      button.metric-chip:hover, button.metric-chip.active { border-color: color-mix(in oklab, var(--teal-600) 50%, transparent); background: var(--teal-tint); }
      .metric-chip span { color: var(--teal-600); font-family: var(--font-mono); }

      .salary-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
      .salary-card { background: var(--match-strong-tint); border: 1px solid color-mix(in oklab, var(--match-strong) 28%, transparent); border-radius: var(--r-md); color: inherit; padding: 16px; text-align: left; }
      button.salary-card { cursor: pointer; width: 100%; transition: all var(--dur) var(--ease-out); }
      button.salary-card:hover, button.salary-card.active { border-color: var(--match-strong); background: color-mix(in oklab, var(--match-strong) 16%, transparent); }
      .salary-card strong { color: var(--match-strong); display: block; font-family: var(--font-display); font-size: 23px; font-weight: 800; }
      .salary-card span { color: var(--fg-subtle); display: block; font-size: 13px; margin-top: 6px; }

      .bar-list { display: grid; gap: 12px; }
      .bar-row { display: grid; gap: 8px; }
      .chart-button { background: transparent; border: 0; border-radius: var(--r-sm); color: inherit; cursor: pointer; padding: 8px; text-align: left; width: 100%; transition: background var(--dur) var(--ease-out); }
      .chart-button:hover, .chart-button.active { background: var(--coral-tint); }
      .chart-button:focus-visible { outline: 2px solid var(--coral-500); outline-offset: 2px; }
      .bar-row-head { align-items: baseline; display: flex; gap: 10px; justify-content: space-between; }
      .bar-label { color: var(--fg); font-weight: 700; }
      .bar-value { color: var(--fg-subtle); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
      .bar-track { background: var(--paper-0); border: 1px solid var(--line-soft); border-radius: 999px; display: block; height: 9px; overflow: hidden; width: 100%; }
      .bar-fill {
        background: var(--coral-400);
        border-radius: inherit;
        display: block;
        height: 9px;
        min-width: 3px;
      }
      .analytics-note { color: var(--fg-subtle); font-size: 14px; margin: 16px 0 0; }
      .analytics-matches { max-height: 980px; overflow: auto; padding-right: 6px; }
      .analytics-matches .job-card { margin-top: 0; }

      /* ---------------------------------------------------------------- responsive */
      @media (max-width: 1080px) {
        .topbar { grid-template-columns: 1fr auto; padding: 14px 18px; }
        .nav-tabs, .search { grid-column: 1 / -1; width: 100%; }
        .app-shell { grid-template-columns: 1fr; padding: 24px 18px 56px; }
        .hero-card { grid-template-columns: 1fr; }
        .signal-board { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .right-rail { position: static; }
      }
      @media (max-width: 720px) {
        .hero-card { padding: 22px 18px; }
        .hero-logo { height: 130px; opacity: 0.07; right: -12px; top: -14px; width: 130px; }
        h1 { font-size: 34px; }
        .hero-copy { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 5; }
        .signal-board { display: none; }
        .stat-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .stat-chip { min-width: 0; padding: 11px; width: 100%; }
        .utility-controls, .analytics-kpis, .analytics-grid, .analytics-subgrid, .job-card, .prefs-grid { grid-template-columns: 1fr; }
        .job-card { gap: 12px; }
        .feedback-box { display: flex; flex-wrap: wrap; justify-items: start; }
        .geo-map { aspect-ratio: 4 / 3; min-height: 0; }
        .avatar { display: none; }
      }

    </style>
  </head>
  <body>
    {% macro role_card(scored, group_name, featured=False, static_discarded=False) -%}
      {% set job_id = job_feedback_id(scored.job) %}
      {% set legacy_job_id = (scored.job.company ~ "|" ~ scored.job.title ~ "|" ~ scored.job.url)|lower|replace(" ", "-")|replace("/", "-")|replace(":", "-")|replace("?", "-")|replace("&", "-") %}
      {% set signal = analytics.job_signals.get(job_id) %}
      {% set fit_copy = scored.job.fit_summary or scored.rationale[0] or scored.job.notes %}
      {% set requirements_copy = scored.job.requirements_summary %}
      {% set network_contacts_copy -%}
        {%- for contact in scored.job.network_contacts -%}
          {{ contact.name }}{% if contact.company %} at {{ contact.company }}{% endif %}{% if contact.position %} ({{ contact.position }}){% endif %}{% if contact.reason %}: {{ contact.reason }}{% endif %}{% if contact.profile_url %} - {{ contact.profile_url }}{% endif %}{% if not loop.last %}; {% endif %}
        {%- endfor -%}
      {%- endset %}
      <article class="job-card{% if featured %} featured{% endif %}" data-job-id="{{ job_id }}" data-legacy-job-id="{{ legacy_job_id }}" data-score="{{ scored.total_score }}" data-location="{{ scored.job.location|lower }}" data-static-discarded="{{ 'true' if static_discarded else 'false' }}" data-title="{{ scored.job.title }}" data-company="{{ scored.job.company }}" data-url="{{ scored.job.url }}" data-fit-summary="{{ fit_copy }}" data-requirements="{{ requirements_copy }}" data-network-summary="{{ scored.job.network_summary }}" data-network-contacts="{{ network_contacts_copy|trim }}" data-analytics-company="{{ signal.company if signal else '' }}" data-geography="{{ signal.geography if signal else '' }}" data-role-family="{{ signal.role_family if signal else '' }}" data-qualifications="{{ signal.qualifications|join('||') if signal else '' }}" data-seniority="{{ signal.seniority if signal else '' }}" data-work-mode="{{ signal.work_mode if signal else '' }}" data-degree="{{ signal.degree_requirement if signal else '' }}" data-clearance="{{ signal.clearance_requirement if signal else '' }}" data-score-band="{{ '80+ priority' if scored.total_score >= 80 else '70-79 strong' if scored.total_score >= 70 else '60-69 promising' if scored.total_score >= 60 else 'Under 60 monitor' }}" data-search="{{ (scored.job.title ~ ' ' ~ scored.job.company ~ ' ' ~ scored.job.location ~ ' ' ~ fit_copy ~ ' ' ~ requirements_copy ~ ' ' ~ scored.job.network_summary ~ ' ' ~ network_contacts_copy ~ ' ' ~ scored.rationale|join(' '))|lower }}">
        <div class="company-tile">{{ scored.job.company[:1] }}</div>
        <div>
          <div class="card-label">
            {% if featured %}
              <span class="top-badge caps">Top pick</span>
              <span>your strongest fit this week</span>
            {% else %}
              <span class="caps">{{ group_name }}</span>
            {% endif %}
          </div>
          {% if scored.job.url and (scored.job.url|string).startswith("http") %}
            <a class="role-link" href="{{ scored.job.url }}" target="_blank" rel="noopener noreferrer">{{ scored.job.title }}</a>
          {% else %}
            <span class="role-link">{{ scored.job.title }}</span>
          {% endif %}
          <div class="meta"><strong>{{ scored.job.company }}</strong><span>/</span><span>{{ scored.job.location or "Location TBD" }}</span></div>
          <p class="why">{{ fit_copy }}</p>
          {% if requirements_copy %}
            <p class="requirements"><strong>Main requirements</strong>{{ requirements_copy }}</p>
          {% endif %}
          {% if scored.job.network_summary or scored.job.network_contacts %}
            <div class="network">
              <strong>First reach context</strong>
              {% if scored.job.network_summary %}<span>{{ scored.job.network_summary }}</span>{% endif %}
              {% if scored.job.network_contacts %}
                <div class="network-list">
                  {% for contact in scored.job.network_contacts %}
                    <span class="network-contact">
                      {% if contact.profile_url %}<a href="{{ contact.profile_url }}">{{ contact.name }}</a>{% else %}{{ contact.name }}{% endif %}
                      {% if contact.company %} / {{ contact.company }}{% endif %}
                      {% if contact.reason %} / {{ contact.reason }}{% endif %}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endif %}
          <div class="tag-row">
            {% for label in scored.labels %}
              <span class="tag">{{ label }}</span>
            {% endfor %}
          </div>
        </div>
        <div class="feedback-box">
          <span class="score-pill">{{ scored.total_score }}% match</span>
          <button class="feedback" data-feedback="shortlist" type="button">Great fit</button>
          <button class="feedback" data-feedback="direction" type="button">Right direction</button>
          <button class="feedback" data-feedback="wrong" type="button">Wrong direction</button>
          <div class="reason-panel direction-reasons" data-direction-reasons>
            <span class="reason-panel-title">What's strong? Select all that apply.</span>
            <label class="reason-option"><input type="checkbox" value="strong_seniority_match">Strong Seniority Match</label>
            <label class="reason-option"><input type="checkbox" value="strong_job_type">Strong Job Type</label>
            <label class="reason-option"><input type="checkbox" value="strong_qualifications">Strong Qualifications</label>
            <button class="reason-submit" data-direction-submit type="button" disabled>Push feedback</button>
          </div>
          <div class="reason-panel wrong-reasons" data-wrong-reasons>
            <span class="reason-panel-title">Why wrong? Select all that apply.</span>
            <label class="reason-option"><input type="checkbox" value="too_senior">Too Senior</label>
            <label class="reason-option"><input type="checkbox" value="too_junior">Too Junior</label>
            <label class="reason-option"><input type="checkbox" value="wrong_qualifications">Wrong Qualifications</label>
            <label class="reason-option"><input type="checkbox" value="wrong_location">Wrong Location</label>
            <label class="reason-option"><input type="checkbox" value="wrong_job_type">Wrong Job Type</label>
            <button class="reason-submit" data-wrong-submit type="button" disabled>Push feedback</button>
          </div>
          <button class="packet-button" data-open-packet type="button">Application packet</button>
        </div>
      </article>
    {%- endmacro %}

    {% macro bar_rows(rows, suffix="roles") -%}
      <div class="bar-list">
        {% for row in rows %}
          <div class="bar-row">
            <div class="bar-row-head">
              <span class="bar-label">{{ row.label }}</span>
              <span class="bar-value">{{ row.count }} {{ suffix }}{% if row.detail %} / {{ row.detail }}{% endif %}</span>
            </div>
            <div class="bar-track" aria-hidden="true"><div class="bar-fill" style="width: {{ row.share }}%;"></div></div>
          </div>
        {% else %}
          <p class="analytics-note">No data yet. This will fill in as the Sheet receives richer postings.</p>
        {% endfor %}
      </div>
    {%- endmacro %}

    {% macro filter_bar_rows(rows, filter_type, suffix="roles") -%}
      <div class="bar-list">
        {% for row in rows %}
          <button class="bar-row chart-button" data-analytics-filter="{{ filter_type }}" data-analytics-value="{{ row.label }}" type="button">
            <span class="bar-row-head">
              <span class="bar-label">{{ row.label }}</span>
              <span class="bar-value">{{ row.count }} {{ suffix }}{% if row.detail %} / {{ row.detail }}{% endif %}</span>
            </span>
            <span class="bar-track" aria-hidden="true"><span class="bar-fill" style="width: {{ row.share }}%;"></span></span>
          </button>
        {% else %}
          <p class="analytics-note">No data yet. This will fill in as the Sheet receives richer postings.</p>
        {% endfor %}
      </div>
    {%- endmacro %}

    <header class="topbar">
      <a class="brand" href="#">
        <img class="brand-mark" src="assets/logo-comet-icon-1024.png" alt="">
        <span class="wordmark"><strong>{{ user_profile.possessive_first_name }}</strong><span>{{ user_profile.site_subtitle }}</span></span>
      </a>
      <nav class="nav-tabs" aria-label="Primary views">
        <button class="active" data-primary-view="this-week" type="button">This week</button>
        <button data-primary-view="all" data-tab-target="all-roles" type="button">All roles</button>
        <button data-primary-view="saved" data-tab-target="saved-roles" type="button">Saved</button>
        <button data-primary-view="analytics" data-tab-target="analytics-dashboard" type="button">Analytics</button>
      </nav>
      <label class="search" aria-label="Search roles">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
        <input id="text-filter" type="search" placeholder="Search roles...">
      </label>
      <div class="avatar" aria-label="{{ user_profile.first_name }}">{{ user_profile.initials }}</div>
    </header>

    <main class="app-shell">
      <section class="main-column">
        <div class="hero-card">
          <img class="hero-logo" src="assets/logo-comet-1024.png" alt="">
          <div class="hero-main">
            <span class="hero-kicker caps">This week's shortlist</span>
            <h1 data-greeting-title>Morning, {{ user_profile.first_name }}<span class="coral-dot">.</span></h1>
            <p class="hero-copy">{{ weekly_takeaway }}</p>
            <div class="stat-row" aria-label="Role summary">
              <div class="stat-chip"><strong>{{ total }}</strong><span class="caps">Listings read</span></div>
              <div class="stat-chip"><strong>{{ groups.get("Top Roles", [])|length }}</strong><span class="caps">Top roles</span></div>
              <div class="stat-chip"><strong>3</strong><span class="caps">Sources scanned</span></div>
            </div>
          </div>
          <div class="signal-board" aria-label="Live search signals">
            <div class="signal-card">
              <span class="caps">Highest signal</span>
              {% set top_role = (groups.get("Top Roles")|first) if groups.get("Top Roles") else (all_jobs|first) %}
              {% if top_role %}
                <strong id="highest-signal-title">{{ top_role.job.title }}</strong>
                <span id="highest-signal-meta">{{ top_role.job.company }} / {{ top_role.total_score }}% match</span>
              {% else %}
                <strong id="highest-signal-title">No priority role yet</strong>
                <span id="highest-signal-meta">New roles will appear as the Sheet updates.</span>
              {% endif %}
            </div>
            <div class="signal-card">
              <span class="caps">Market tilt</span>
              {% set city = analytics.city_markets|first %}
              <strong>{{ city.label if city else "No geography yet" }}</strong>
              <span>{{ city.count if city else 0 }} current roles in the strongest visible location.</span>
            </div>
            <div class="signal-card">
              <span class="caps">Role mix</span>
              {% set role_mix = analytics.role_family_mix|first %}
              <strong>{{ role_mix.label if role_mix else "Awaiting taxonomy" }}</strong>
              <span>{{ role_mix.count if role_mix else 0 }} roles in the leading standardized category.</span>
            </div>
          </div>
        </div>

        <nav class="filters" aria-label="Role categories">
          {% for group_name, jobs in groups.items() %}
            <button class="quick-filter{% if loop.first %} active{% endif %}" data-tab-target="tab-{{ loop.index }}" data-tab-label="{{ group_name }}" type="button">
              <span>{{ group_name }}</span> / <span data-tab-count>{{ jobs|length }}</span>
            </button>
          {% endfor %}
        </nav>

        <div class="utility-controls" aria-label="Job filters">
          <div class="control">
            <label for="location-filter">Location</label>
            <select id="location-filter">
              <option value="">All locations</option>
              <option value="dfw">DFW</option>
              <option value="denton">Denton</option>
              <option value="dallas">Dallas</option>
              <option value="plano-frisco">Plano / Frisco / Richardson</option>
              <option value="fort-worth-irving-addison">Fort Worth / Irving / Addison</option>
              <option value="austin-houston">Austin / Houston</option>
              <option value="austin">Austin</option>
              <option value="houston">Houston</option>
              <option value="remote">Remote</option>
              <option value="texas">Texas</option>
            </select>
          </div>
          <div class="control">
            <label for="score-filter">Minimum score</label>
            <input id="score-filter" type="range" min="0" max="100" value="0">
            <span><span id="score-value">0</span>+ match</span>
          </div>
          <div class="control">
            <label for="feedback-filter">Feedback</label>
            <select id="feedback-filter">
              <option value="">All feedback</option>
              <option value="shortlist">Great fit</option>
              <option value="direction">Right direction</option>
              <option value="wrong">Wrong direction</option>
              <option value="unrated">Unrated</option>
            </select>
          </div>
        </div>

        <section class="tab-panel" id="all-roles" data-tab-panel="all-roles" data-view-kind="all">
          <div class="section-head">
            <h2>All Roles</h2>
            <span class="caps">{{ all_jobs|length }} roles in view</span>
          </div>
          <div class="role-list">
            {% for scored in all_jobs %}
              {{ role_card(scored, "All Roles") }}
            {% endfor %}
          </div>
        </section>

        <section class="tab-panel" id="saved-roles" data-tab-panel="saved-roles" data-view-kind="saved">
          <div class="section-head">
            <h2>Saved</h2>
            <span class="caps">0 roles in view</span>
          </div>
          <div class="role-list">
            {% for scored in all_jobs %}
              {{ role_card(scored, "Saved") }}
            {% endfor %}
            <article class="job-card empty-state">
              <div class="company-tile">S</div>
              <div>
                <div class="card-label"><span class="caps">Saved</span></div>
                <h2>No saved roles yet</h2>
                <p class="why">Mark a role as Great fit and it will appear here automatically.</p>
              </div>
            </article>
          </div>
        </section>

        <section class="tab-panel" id="analytics-dashboard" data-tab-panel="analytics-dashboard" data-view-kind="analytics">
          <div class="section-head">
            <h2>Search Analytics</h2>
            <span class="caps">standardized market read</span>
          </div>
          <div class="analytics-dashboard">
            <div class="analytics-kpis">
              <div class="analytics-kpi"><strong>{{ analytics.role_family_mix|sum(attribute="count") }}</strong><span class="caps">target roles analyzed</span></div>
              <div class="analytics-kpi"><strong>{{ analytics.geography_map|length }}</strong><span class="caps">geo buckets</span></div>
              <div class="analytics-kpi"><strong>{{ analytics.cleanup_count }}</strong><span class="caps">rows excluded / cleanup</span></div>
            </div>
            <div class="analytics-toolbar">
              <strong>Interactive read</strong>
              <span class="analytics-filter-chip" id="analytics-filter-chip"></span>
              <button class="analytics-clear" id="clear-analytics-filter" type="button">Clear analytics filter</button>
            </div>
            <div class="analytics-grid">
              <section class="analytics-module map-module">
                <h3>Where The Market Is Showing Up</h3>
                <span class="caps">click a city for top five current roles</span>
                <div class="geo-map" id="job-market-map" aria-label="Interactive US map of role volume by city">
                  <div class="geo-map-loading" id="job-market-map-loading">
                    {% if analytics.city_markets %}Loading map...{% else %}No clean geography data yet.{% endif %}
                  </div>
                </div>
                <div class="city-detail" id="city-detail">
                  {% for city in analytics.city_markets %}
                    <div data-city-panel="{{ loop.index0 }}" data-city-value="{{ city.label }}" {% if not loop.first %}hidden{% endif %}>
                      <h4>{{ city.label }}</h4>
                      <span class="caps">top open roles by rating</span>
                      <ol class="city-role-list">
                        {% for role in city.jobs %}
                          <li>
                            <span class="city-score">{{ role.score }}%</span>
                            <div>
                              {% if role.url and role.url.startswith("http") %}
                                <a href="{{ role.url }}" target="_blank" rel="noopener noreferrer">{{ role.title }}</a>
                              {% else %}
                                <a>{{ role.title }}</a>
                              {% endif %}
                              <span>{{ role.company }}</span>
                            </div>
                          </li>
                        {% endfor %}
                      </ol>
                    </div>
                  {% else %}
                    <p class="analytics-note">When current roles have city data, the top five will appear here.</p>
                  {% endfor %}
                </div>
              </section>
              <section class="analytics-module">
                <h3>Job Types By Geography</h3>
                <span class="caps">stacked by standardized role family</span>
                <div class="stack-list">
                  {% set palette = ["#ee7d66", "#56b6bd", "#c9ec57", "#60c878", "#9c9081", "#f4ede1", "#b98cff", "#f1b56d"] %}
                  {% for geography, rows in analytics.geography_role_demand.items() %}
                    <button class="stack-row chart-button" data-analytics-filter="geography" data-analytics-value="{{ geography }}" type="button">
                      <div class="stack-row-head"><span class="stack-label">{{ geography }}</span><span class="bar-value">{{ rows|sum(attribute="count") }} roles</span></div>
                      <div class="stack-track" aria-hidden="true">
                        {% for row in rows %}
                          <span class="stack-segment" title="{{ row.label }}: {{ row.count }}" style="width: {{ row.share }}%; --segment-color: {{ palette[loop.index0 % palette|length] }};"></span>
                        {% endfor %}
                      </div>
                    </button>
                  {% else %}
                    <p class="analytics-note">No clean role-family data yet.</p>
                  {% endfor %}
                </div>
                <div class="legend">
                  {% for row in analytics.role_family_mix %}
                    <span><i style="--legend-color: {{ palette[loop.index0 % palette|length] }}"></i>{{ row.label }}</span>
                  {% endfor %}
                </div>
              </section>
            </div>
            <div class="analytics-grid">
              <section class="analytics-module">
                <h3>Quality Distribution</h3>
                {{ filter_bar_rows(analytics.score_bands, "scoreBand") }}
                <p class="analytics-note">Use this to see whether new intake is producing priority leads or mostly calibration examples.</p>
              </section>
              <section class="analytics-module">
                <h3>Companies Hiring Most</h3>
                <div class="analytics-subgrid">
                  {% for geography, rows in analytics.top_companies_by_geography.items() %}
                    <div>
                      <span class="caps">{{ geography }}</span>
                      {{ filter_bar_rows(rows[:4], "company") }}
                    </div>
                  {% else %}
                    <p class="analytics-note">No clean company concentration data yet.</p>
                  {% endfor %}
                </div>
              </section>
              <section class="analytics-module">
                <h3>Standard Job Type Mix</h3>
                {{ filter_bar_rows(analytics.role_family_mix, "roleFamily") }}
                <p class="analytics-note">Every posting is forced into this limited taxonomy so one-off titles do not create one-off chart categories.</p>
              </section>
            </div>
            <div class="analytics-grid">
              <section class="analytics-module">
                <h3>Seniority Fit</h3>
                {{ filter_bar_rows(analytics.seniority_mix, "seniority") }}
                <p class="analytics-note">Useful for spotting drift toward roles that are too senior, too junior, or properly stretch-level.</p>
              </section>
              <section class="analytics-module">
                <h3>Work Mode</h3>
                {{ filter_bar_rows(analytics.work_mode_mix, "workMode") }}
                <p class="analytics-note">Separates practical flexibility from role fit so location tradeoffs stay visible.</p>
              </section>
            </div>
            <div class="analytics-grid">
              <section class="analytics-module">
                <h3>Qualifications In Demand</h3>
                <div class="chip-cloud">
                  {% for row in analytics.qualification_demand %}
                    <button class="metric-chip" data-analytics-filter="qualification" data-analytics-value="{{ row.label }}" type="button">{{ row.label }} <span>{{ row.count }}</span></button>
                  {% else %}
                    <p class="analytics-note">No requirement summaries available yet.</p>
                  {% endfor %}
                </div>
                <p class="analytics-note">Derived from requirements summaries and public posting text, not unique job titles.</p>
              </section>
              <section class="analytics-module">
                <h3>Average Salary Signals</h3>
                <div class="salary-grid">
                  {% for row in analytics.salary_by_role_family %}
                    <button class="salary-card" data-analytics-filter="roleFamily" data-analytics-value="{{ row.label }}" type="button">
                      <strong>${{ "{:,}".format(row.count) }}</strong>
                      <span>{{ row.label }} / {{ row.detail }}</span>
                    </button>
                  {% else %}
                    <p class="analytics-note">No compensation fields found in the current public postings.</p>
                  {% endfor %}
                </div>
                <p class="analytics-note">Only postings with public compensation are counted.</p>
              </section>
            </div>
            <div class="analytics-grid">
              <section class="analytics-module">
                <h3>Degree Signals</h3>
                {{ filter_bar_rows(analytics.degree_mix, "degree") }}
                <p class="analytics-note">Highlights whether postings are asking for explicit credentials or leaving room for experience-based fits.</p>
              </section>
              <section class="analytics-module">
                <h3>Clearance / Citizenship Signals</h3>
                {{ filter_bar_rows(analytics.clearance_mix, "clearance") }}
                <p class="analytics-note">Keeps defense-adjacent barriers visible before a role absorbs application time.</p>
              </section>
            </div>
            <div class="analytics-grid">
              <section class="analytics-module">
                <h3>Strongest First-Reach Paths</h3>
                {{ bar_rows(analytics.strongest_contacts, "pts") }}
                <p class="analytics-note">Sanitized LinkedIn-derived context only; raw exports stay local.</p>
              </section>
              <section class="analytics-module">
                <h3>Data Cleanup Queue</h3>
                <p class="why" style="margin-top: 0;">{{ analytics.cleanup_count }} rows were excluded from analytics because they look technical/non-target or have polluted fields such as packed URLs in company, title, or location.</p>
                <p class="analytics-note">Those rows can still appear in role review tabs, but they no longer distort the aggregate dashboard.</p>
              </section>
            </div>
            <section class="analytics-module">
              <h3>Analytics Matches</h3>
              <span class="caps" id="analytics-match-count">target roles in view</span>
              <div class="role-list analytics-matches" id="analytics-matches">
                {% for scored in all_jobs %}
                  {{ role_card(scored, "Analytics") }}
                {% endfor %}
                <article class="job-card empty-state">
                  <div class="company-tile">S</div>
                  <div>
                    <div class="card-label"><span class="caps">Analytics</span></div>
                    <h2>No roles match this analytical slice</h2>
                    <p class="why">Clear the analytics filter or pick a broader market signal.</p>
                  </div>
                </article>
              </div>
            </section>
          </div>
        </section>

        {% for group_name, jobs in groups.items() %}
          {% set panel_jobs = all_jobs if group_name == "Discarded" else jobs %}
          <section class="tab-panel{% if loop.first %} active{% endif %}" id="tab-{{ loop.index }}" data-tab-panel="tab-{{ loop.index }}" data-view-kind="{{ 'discarded' if group_name == 'Discarded' else 'category' }}">
            <div class="section-head">
              <h2>{{ group_name }}</h2>
              <span class="caps" id="visible-count-label">{{ jobs|length }} roles in view</span>
            </div>
            <div class="role-list">
              {% for scored in panel_jobs %}
                {{ role_card(scored, group_name, group_name == "Top Roles" and loop.first, scored in groups["Discarded"]) }}
              {% endfor %}
                <article class="job-card empty-state">
                  <div class="company-tile">S</div>
                  <div>
                    <div class="card-label"><span class="caps">{{ group_name }}</span></div>
                    <h2>No roles here yet</h2>
                    <p class="why">When the Sheet backend receives a matching role, it will appear in this tab on the next site refresh.</p>
                  </div>
                </article>
            </div>
          </section>
        {% endfor %}

        <p class="pipeline-note">Records marked as needing review should be checked before applying or rejecting permanently. Feedback you mark here can be exported and used to recalibrate scoring and future searches.</p>
      </section>

      <aside class="right-rail" aria-label="Career profile">
        <section class="side-card profile-card">
          <img class="profile-avatar" src="assets/logo-comet-icon-1024.png" alt="">
          <div>
