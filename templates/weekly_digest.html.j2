            <button class="action-button" id="clear-filters" type="button">Clear filters</button>
          </div>
        </section>
      </aside>
    </main>

    <div id="packet-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="packet-title">
      <div class="modal-panel">
        <h2 id="packet-title">Application Packet</h2>
        <p id="packet-context" style="color: var(--cream-500); margin-top: 8px;"></p>
        <p style="color: var(--cream-500);">This prompt is generated directly from the job card. Copy it into ChatGPT to draft the tailored resume and cover letter.</p>
        <pre class="packet-output" id="packet-prompt"></pre>
        <p style="color: var(--cream-500);">Optional deeper version: run this locally if you want the packet to include excerpts from your local DOCX examples.</p>
        <pre class="packet-output" id="packet-command"></pre>
        <div class="action-row">
          <button class="action-button" id="open-chatgpt" type="button">Open in ChatGPT</button>
          <button class="action-button" id="copy-packet-prompt" type="button">Copy prompt</button>
          <button class="action-button" id="copy-packet-command" type="button">Copy command</button>
          <button class="action-button" id="close-packet" type="button">Close</button>
        </div>
      </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js"></script>
    <script>
      const defaultPreferences = {
        locations: "Dallas-Fort Worth\nDenton\nDallas\nPlano\nFrisco\nRichardson\nFort Worth\nIrving\nAddison\nAustin\nHouston\nRemote for research, finance, or analyst-style internships",
        roles: "Investment Banking Intern\nPrivate Equity Intern\nSearch Fund Intern\nFinancial Analyst Intern\nInvestment Analyst Intern\nEquity Research Intern\nCorporate Finance Intern\nValuation Intern\nM&A Intern\nWealth Management Intern\nAsset Management Intern\nVenture Capital Intern",
        sectors: "Investment banking\nPrivate equity\nSearch funds\nAsset management\nWealth management\nCorporate finance\nValuation\nFinancial consulting\nVenture capital\nFintech\nReal estate investment\nM&A advisory\nRegional banking",
        avoid: "Pure sales roles\nCommission-only financial advisor roles\nInsurance sales\nDoor-to-door sales\nUnpaid internships with heavy workload\nUnrelated customer service roles\nOut-of-state roles requiring immediate relocation without housing or relocation support\nRoles requiring a completed bachelor's degree unless current students are accepted",
        compensation: "$18-$35/hour for internships; $50,000-$80,000+ annualized for entry-level analyst-style roles",
        priorities: "Student-friendly schedule\nFinance learning curve\nModeling / valuation exposure\nCompany research and due diligence\nDFW location\nMentorship\nBrand / resume signal\nPotential return offer\nCompensation"
      };
      const feedbackKey = "job-search-agent.feedback";
      const wrongReasonsKey = "job-search-agent.wrongReasons";
      const directionReasonsKey = "job-search-agent.directionReasons";
      const calibrationPayloadKey = "job-search-agent.calibrationPayload";
      const preferenceKey = "job-search-agent.preferences.ferris.v2";
      const viewStateKey = "job-search-agent.viewState";
      const userFirstName = {{ user_profile.first_name|tojson }};
      const userFullName = {{ user_profile.full_name|tojson }};
      const applicationContext = {{ user_profile.application_context|tojson }};
      const feedback = JSON.parse(localStorage.getItem(feedbackKey) || "{}");
      const wrongReasons = JSON.parse(localStorage.getItem(wrongReasonsKey) || "{}");
      const directionReasons = JSON.parse(localStorage.getItem(directionReasonsKey) || "{}");
      const rows = Array.from(document.querySelectorAll(".job-card[data-job-id]"));
      const greetingTitle = document.querySelector("[data-greeting-title]");
      const primaryButtons = Array.from(document.querySelectorAll(".nav-tabs button[data-primary-view]"));
      const tabButtons = Array.from(document.querySelectorAll(".quick-filter"));
      const tabPanels = Array.from(document.querySelectorAll(".tab-panel"));
      const scoreFilter = document.getElementById("score-filter");
      const scoreValue = document.getElementById("score-value");
      const locationFilter = document.getElementById("location-filter");
      const feedbackFilter = document.getElementById("feedback-filter");
      const textFilter = document.getElementById("text-filter");
      const savedCount = document.getElementById("saved-count");
      const highestSignalTitle = document.getElementById("highest-signal-title");
      const highestSignalMeta = document.getElementById("highest-signal-meta");
      const analyticsFilterChip = document.getElementById("analytics-filter-chip");
      const clearAnalyticsFilterButton = document.getElementById("clear-analytics-filter");
      const analyticsMatchCount = document.getElementById("analytics-match-count");
      const packetModal = document.getElementById("packet-modal");
      const packetContext = document.getElementById("packet-context");
      const packetCommand = document.getElementById("packet-command");
      const packetPrompt = document.getElementById("packet-prompt");
      let activeAnalyticsFilter = null;

      function greetingForHour(hour) {
        if (hour >= 22 || hour < 5) return "Good Night";
        if (hour < 12) return "Morning";
        if (hour < 17) return "Afternoon";
        return "Evening";
      }

      function updateGreetingTitle(date = new Date()) {
        if (!greetingTitle) return;
        greetingTitle.innerHTML = `${greetingForHour(date.getHours())}, {{ user_profile.first_name }}<span class="coral-dot">.</span>`;
      }

      updateGreetingTitle();

      const cityMarkets = [
        {% for city in analytics.city_markets %}
          {% if city.longitude is not none and city.latitude is not none %}
            {
              panelIndex: {{ loop.index0 }},
              label: {{ city.label|tojson }},
              count: {{ city.count }},
              longitude: {{ city.longitude }},
              latitude: {{ city.latitude }}
            }{% if not loop.last %},{% endif %}
          {% endif %}
        {% endfor %}
      ].filter(Boolean);

      function saveFeedback() {
        localStorage.setItem(feedbackKey, JSON.stringify(feedback));
        localStorage.setItem(wrongReasonsKey, JSON.stringify(wrongReasons));
        localStorage.setItem(directionReasonsKey, JSON.stringify(directionReasons));
        localStorage.setItem(calibrationPayloadKey, JSON.stringify(buildCalibrationPayload()));
      }

      function feedbackForJob(jobId) {
        const value = feedback[jobId];
        if (value && typeof value === "object") return value.signal || "";
        return value || "";
      }

      function wrongReasonsForJob(jobId) {
        return Array.isArray(wrongReasons[jobId]) ? wrongReasons[jobId] : [];
      }

      function directionReasonsForJob(jobId) {
        return Array.isArray(directionReasons[jobId]) ? directionReasons[jobId] : [];
      }

      function jobsForCalibration() {
        const jobs = {};
        rows.forEach((row) => {
          if (!row.dataset.jobId || jobs[row.dataset.jobId]) return;
          jobs[row.dataset.jobId] = {
            title: row.dataset.title || "",
            company: row.dataset.company || "",
            location: row.dataset.location || "",
            url: row.dataset.url || "",
            fitSummary: row.dataset.fitSummary || "",
            requirements: row.dataset.requirements || "",
            networkSummary: row.dataset.networkSummary || ""
          };
        });
        return jobs;
      }

      function buildCalibrationPayload() {
        return {
          exportedAt: new Date().toISOString(),
          preferences: JSON.parse(localStorage.getItem(preferenceKey) || JSON.stringify(defaultPreferences)),
          feedback,
          directionReasons,
          wrongReasons,
          jobs: jobsForCalibration()
        };
      }

      function selectedDirectionReasons(row) {
        return Array.from(row.querySelectorAll("[data-direction-reasons] input[type='checkbox']:checked")).map((item) => item.value);
      }

      function selectedWrongReasons(row) {
        return Array.from(row.querySelectorAll("[data-wrong-reasons] input[type='checkbox']:checked")).map((item) => item.value);
      }

      function updateDirectionReasonSubmitState(row) {
        const submit = row.querySelector("[data-direction-submit]");
        if (submit) submit.disabled = selectedDirectionReasons(row).length === 0;
      }

      function updateWrongReasonSubmitState(row) {
        const submit = row.querySelector("[data-wrong-submit]");
        if (submit) submit.disabled = selectedWrongReasons(row).length === 0;
      }

      function setDirectionReasonPanelOpen(row, isOpen) {
        const reasonPanel = row.querySelector("[data-direction-reasons]");
        if (!reasonPanel) return;
        reasonPanel.classList.toggle("is-open", isOpen);
        updateDirectionReasonSubmitState(row);
      }

      function setWrongReasonPanelOpen(row, isOpen) {
        const reasonPanel = row.querySelector("[data-wrong-reasons]");
        if (!reasonPanel) return;
        reasonPanel.classList.toggle("is-open", isOpen);
        updateWrongReasonSubmitState(row);
      }

      function migrateLegacyFeedback() {
        let changed = false;
        rows.forEach((row) => {
          const jobId = row.dataset.jobId;
          const legacyJobId = row.dataset.legacyJobId;
          if (!jobId || !legacyJobId || jobId === legacyJobId || feedback[jobId] || !feedback[legacyJobId]) return;
          feedback[jobId] = feedback[legacyJobId];
          if (wrongReasons[legacyJobId] && !wrongReasons[jobId]) wrongReasons[jobId] = wrongReasons[legacyJobId];
          if (directionReasons[legacyJobId] && !directionReasons[jobId]) directionReasons[jobId] = directionReasons[legacyJobId];
          changed = true;
        });
        if (changed) saveFeedback();
      }

      function paintFeedbackForJob(jobId, options = {}) {
        const keepPanelsClosed = options.keepPanelsClosed || false;
        const current = feedbackForJob(jobId);
        const currentReasons = wrongReasonsForJob(jobId);
        const currentDirectionReasons = directionReasonsForJob(jobId);
        rows.filter((row) => row.dataset.jobId === jobId).forEach((row) => {
          row.querySelectorAll(".feedback").forEach((button) => {
            button.classList.toggle("active", button.dataset.feedback === current);
          });
          const directionPanel = row.querySelector("[data-direction-reasons]");
          if (directionPanel) {
            directionPanel.querySelectorAll("input[type='checkbox']").forEach((checkbox) => {
              checkbox.checked = currentDirectionReasons.includes(checkbox.value);
            });
            setDirectionReasonPanelOpen(row, !keepPanelsClosed && current === "direction");
          }
          const reasonPanel = row.querySelector("[data-wrong-reasons]");
          if (reasonPanel) {
            reasonPanel.querySelectorAll("input[type='checkbox']").forEach((checkbox) => {
              checkbox.checked = currentReasons.includes(checkbox.value);
            });
            setWrongReasonPanelOpen(row, !keepPanelsClosed && current === "wrong");
          }
        });
      }

      function updateSavedCount() {
        savedCount.textContent = String(Object.keys(feedback).filter((jobId) => feedbackForJob(jobId) === "shortlist").length);
      }

      function updateHighestSignal() {
        if (!highestSignalTitle || !highestSignalMeta) return;
        const candidates = new Map();
        rows.forEach((row) => {
          const jobId = row.dataset.jobId;
          if (!jobId || candidates.has(jobId)) return;
          if (feedbackForJob(jobId) === "wrong" || row.dataset.staticDiscarded === "true") return;
          candidates.set(jobId, row);
        });
        const winner = Array.from(candidates.values()).sort((a, b) => Number(b.dataset.score || 0) - Number(a.dataset.score || 0))[0];
        if (!winner) {
          highestSignalTitle.textContent = "No priority role yet";
          highestSignalMeta.textContent = "New roles will appear as the Sheet updates.";
          return;
        }
        highestSignalTitle.textContent = winner.dataset.title || "Untitled role";
        highestSignalMeta.textContent = `${winner.dataset.company || "Unknown company"} / ${Number(winner.dataset.score || 0)}% match`;
      }

      function activePanel() {
        return document.querySelector(".tab-panel.active");
      }

      function setActivePanel(target) {
        tabPanels.forEach((panel) => panel.classList.toggle("active", panel.dataset.tabPanel === target));
      }

      function syncPrimaryNav(view) {
        primaryButtons.forEach((button) => button.classList.toggle("active", button.dataset.primaryView === view));
      }

      function syncCategoryTabs(target) {
        tabButtons.forEach((button) => button.classList.toggle("active", button.dataset.tabTarget === target));
      }

      function panelExists(target) {
        return !!target && tabPanels.some((panel) => panel.dataset.tabPanel === target);
      }

      function primaryViewForPanel(target) {
        if (target === "all-roles") return "all";
        if (target === "saved-roles") return "saved";
        if (target === "analytics-dashboard") return "analytics";
        return "this-week";
      }

      function saveViewState(view, panelTarget) {
        if (!panelExists(panelTarget)) return;
        const state = { view, panelTarget };
        localStorage.setItem(viewStateKey, JSON.stringify(state));
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, "", `#${panelTarget}`);
        }
      }

      function restoreViewState() {
        let saved = {};
        try {
          saved = JSON.parse(localStorage.getItem(viewStateKey) || "{}");
        } catch (error) {
          saved = {};
        }
        const hashTarget = decodeURIComponent(window.location.hash.replace(/^#/, ""));
        const panelTarget = panelExists(hashTarget) ? hashTarget : panelExists(saved.panelTarget) ? saved.panelTarget : "";
        if (!panelTarget) return;
        const view = primaryViewForPanel(panelTarget);
        setActivePanel(panelTarget);
        syncPrimaryNav(view);
        syncCategoryTabs(view === "this-week" ? panelTarget : "");
      }

      const locationAliases = {
        dfw: ["dfw", "dallas", "fort worth", "plano", "frisco", "richardson", "irving", "addison", "denton"],
        denton: ["denton"],
        dallas: ["dallas"],
        "plano-frisco": ["plano", "frisco", "richardson"],
        "fort-worth-irving-addison": ["fort worth", "irving", "addison"],
        "austin-houston": ["austin", "houston"],
        austin: ["austin"],
        houston: ["houston"],
        remote: ["remote"],
        texas: ["tx", "texas", "dfw", "dallas", "fort worth", "plano", "frisco", "richardson", "irving", "addison", "denton", "austin", "houston"]
      };

      function matchesLocation(row, locationValue) {
        if (!locationValue) return true;
        const fields = [
          row.dataset.location || "",
          row.dataset.geography || "",
          row.dataset.search || ""
        ].join(" ").toLowerCase();
        const aliases = locationAliases[locationValue] || [locationValue];
        return aliases.some((alias) => fields.includes(alias));
      }

      function matchesCurrentFilters(row, viewKind) {
        const minScore = Number(scoreFilter.value);
        const location = locationFilter.value;
        const feedbackValue = feedbackFilter.value;
        const text = textFilter.value.trim().toLowerCase();
        const rowFeedback = feedbackForJob(row.dataset.jobId);
        const isStaticDiscarded = row.dataset.staticDiscarded === "true";
        const matchesView =
          viewKind === "saved"
            ? rowFeedback === "shortlist"
            : viewKind === "discarded"
              ? rowFeedback === "wrong" || isStaticDiscarded
              : viewKind === "category"
                ? rowFeedback !== "wrong" && !isStaticDiscarded
                : true;
        const matchesLocationFilter = matchesLocation(row, location);
        const matchesScore = Number(row.dataset.score) >= minScore;
        const matchesFeedback = !feedbackValue || (feedbackValue === "unrated" ? !rowFeedback : rowFeedback === feedbackValue);
        const matchesText = !text || row.dataset.search.includes(text);
        return matchesView && matchesLocationFilter && matchesScore && matchesFeedback && matchesText;
      }

      function analyticsDatasetKey(type) {
        return {
          geography: "geography",
          company: "analyticsCompany",
          roleFamily: "roleFamily",
          seniority: "seniority",
          workMode: "workMode",
          degree: "degree",
          clearance: "clearance",
          scoreBand: "scoreBand"
        }[type] || "";
      }

      function matchesAnalyticsFilter(row) {
        const rowFeedback = feedbackForJob(row.dataset.jobId);
        const isStaticDiscarded = row.dataset.staticDiscarded === "true";
        if (rowFeedback === "wrong" || isStaticDiscarded) return false;
        if (!row.dataset.roleFamily) return false;
        if (!activeAnalyticsFilter) return true;
        if (activeAnalyticsFilter.type === "qualification") {
          return row.dataset.qualifications.split("||").includes(activeAnalyticsFilter.value);
        }
        const key = analyticsDatasetKey(activeAnalyticsFilter.type);
        return key ? row.dataset[key] === activeAnalyticsFilter.value : true;
      }

      function updateAnalyticsFilterUI() {
        document.querySelectorAll("[data-analytics-filter]").forEach((button) => {
          button.classList.toggle(
            "active",
            !!activeAnalyticsFilter &&
              button.dataset.analyticsFilter === activeAnalyticsFilter.type &&
              button.dataset.analyticsValue === activeAnalyticsFilter.value
          );
        });
        if (!analyticsFilterChip) return;
        if (!activeAnalyticsFilter) {
          analyticsFilterChip.textContent = "";
          analyticsFilterChip.classList.remove("is-visible");
          return;
        }
        analyticsFilterChip.textContent = `${activeAnalyticsFilter.label}: ${activeAnalyticsFilter.value}`;
        analyticsFilterChip.classList.add("is-visible");
      }

      function applyAnalyticsFilters() {
        const analyticsPanel = document.getElementById("analytics-dashboard");
        if (!analyticsPanel) return 0;
        const analyticsRows = Array.from(analyticsPanel.querySelectorAll("#analytics-matches .job-card[data-job-id]"));
        let visible = 0;
        analyticsRows.forEach((row) => {
          const matches = matchesAnalyticsFilter(row);
          row.classList.toggle("is-hidden", !matches);
          if (matches) visible += 1;
        });
        analyticsPanel.classList.toggle("is-empty", visible === 0);
        if (analyticsMatchCount) analyticsMatchCount.textContent = `${visible} target roles in view`;
        updateAnalyticsFilterUI();
        return visible;
      }

      function applyPanelFilters(panel) {
        if (!panel) return;
        if (panel.dataset.viewKind === "analytics") {
          applyAnalyticsFilters();
          return;
        }
        const viewKind = panel.dataset.viewKind || "category";
        Array.from(panel.querySelectorAll(".job-card[data-job-id]")).forEach((row) => {
          row.classList.toggle("is-hidden", !matchesCurrentFilters(row, viewKind));
        });
      }

      function visibleRowsForPanel(panel) {
        if (!panel) return [];
        const viewKind = panel.dataset.viewKind || "category";
        return Array.from(panel.querySelectorAll(".job-card[data-job-id]")).filter((row) => matchesCurrentFilters(row, viewKind));
      }

      function updatePanelCount(panel) {
        if (panel && panel.dataset.viewKind === "analytics") return 0;
        const visible = visibleRowsForPanel(panel).length;
        const label = panel ? panel.querySelector(".section-head .caps") : null;
        if (label) label.textContent = `${visible} roles in view`;
        if (panel) panel.classList.toggle("is-empty", visible === 0);
        return visible;
      }

      function updateCategoryCounts() {
        tabButtons.forEach((button) => {
          const panel = document.querySelector(`.tab-panel[data-tab-panel="${button.dataset.tabTarget}"]`);
          const count = updatePanelCount(panel);
          const countNode = button.querySelector("[data-tab-count]");
          if (countNode) countNode.textContent = String(count);
        });
      }

      function applyFilters() {
        tabPanels.forEach((panel) => applyPanelFilters(panel));
        updatePanelCount(activePanel());
        updateCategoryCounts();
        scoreValue.textContent = scoreFilter.value;
        updateSavedCount();
        updateHighestSignal();
        applyAnalyticsFilters();
      }

      migrateLegacyFeedback();

      rows.forEach((row) => {
        paintFeedbackForJob(row.dataset.jobId, { keepPanelsClosed: true });
        row.querySelectorAll(".feedback").forEach((button) => {
          button.addEventListener("click", () => {
            const current = feedbackForJob(row.dataset.jobId);
            if (button.dataset.feedback === "direction") {
              if (current === "direction") {
                setDirectionReasonPanelOpen(row, true);
                return;
              }
              row.querySelectorAll(".feedback").forEach((feedbackButton) => feedbackButton.classList.remove("active"));
              button.classList.add("active");
              setDirectionReasonPanelOpen(row, true);
              setWrongReasonPanelOpen(row, false);
              return;
            }
            if (button.dataset.feedback === "wrong") {
              if (current === "wrong") {
                setWrongReasonPanelOpen(row, true);
                return;
              }
              row.querySelectorAll(".feedback").forEach((feedbackButton) => feedbackButton.classList.remove("active"));
              button.classList.add("active");
              setDirectionReasonPanelOpen(row, false);
              setWrongReasonPanelOpen(row, true);
              return;
            }
            feedback[row.dataset.jobId] = current === button.dataset.feedback ? "" : button.dataset.feedback;
            if (!feedback[row.dataset.jobId]) delete feedback[row.dataset.jobId];
            delete wrongReasons[row.dataset.jobId];
            delete directionReasons[row.dataset.jobId];
            saveFeedback();
            paintFeedbackForJob(row.dataset.jobId);
            applyFilters();
          });
        });
        row.querySelectorAll("[data-direction-reasons] input[type='checkbox']").forEach((checkbox) => {
          checkbox.addEventListener("change", () => {
            updateDirectionReasonSubmitState(row);
          });
        });
        const directionSubmitButton = row.querySelector("[data-direction-submit]");
        if (directionSubmitButton) {
          directionSubmitButton.addEventListener("click", () => {
            const selected = selectedDirectionReasons(row);
            if (!selected.length) {
              updateDirectionReasonSubmitState(row);
              return;
            }
            directionReasons[row.dataset.jobId] = selected;
            delete wrongReasons[row.dataset.jobId];
            feedback[row.dataset.jobId] = "direction";
            saveFeedback();
            paintFeedbackForJob(row.dataset.jobId, { keepPanelsClosed: true });
            applyFilters();
          });
        }
        row.querySelectorAll("[data-wrong-reasons] input[type='checkbox']").forEach((checkbox) => {
          checkbox.addEventListener("change", () => {
            updateWrongReasonSubmitState(row);
          });
        });
        const wrongSubmitButton = row.querySelector("[data-wrong-submit]");
        if (wrongSubmitButton) {
          wrongSubmitButton.addEventListener("click", () => {
            const selected = selectedWrongReasons(row);
            if (!selected.length) {
              updateWrongReasonSubmitState(row);
              return;
            }
            wrongReasons[row.dataset.jobId] = selected;
            delete directionReasons[row.dataset.jobId];
            feedback[row.dataset.jobId] = "wrong";
            saveFeedback();
            paintFeedbackForJob(row.dataset.jobId, { keepPanelsClosed: true });
            applyFilters();
          });
        }
        const packetButton = row.querySelector("[data-open-packet]");
        if (packetButton) {
          packetButton.addEventListener("click", () => openPacketModal(row));
        }
      });

      function shellQuote(value) {
        return `'${String(value || "").replace(/'/g, `'\\''`)}'`;
      }

      function packetCommandForRow(row) {
        return [
          'cd "/path/to/job-search-agent"',
          'export GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"',
          `PYTHONPATH=src python3 -m job_search_agent.application_materials --job-id ${shellQuote(row.dataset.jobId)}`
        ].join("\n");
      }

      function packetPromptForRow(row) {
        return [
          "# Application Packet Prompt",
          "",
          `You are helping ${userFullName} draft job application materials. Produce:`,
          "",
          "1. A one-page resume tailored to the target role.",
          `2. A cover letter in ${userFirstName}'s natural style.`,
          "3. A short tailoring note listing which experiences you emphasized and why.",
          "",
          "## Non-Negotiables",
          "",
          "- Do not invent degrees, employers, titles, dates, languages, skills, metrics, eligibility, citizenship, clearance status, or personal facts.",
          "- Do not use generic AI-sounding phrasing such as \"I am uniquely positioned,\" \"dynamic professional,\" \"leveraging synergies,\" or \"passionate about driving impact.\"",
          `- Keep the voice direct, specific, and human. It should read like a real application written by ${userFirstName}.`,
          "- If the job appears to require an engineering degree, software engineering background, or deep technical implementation, flag that concern before drafting.",
          "- If a requirement is unknown, say so in the tailoring note instead of filling the gap.",
          `- Prefer concrete experience from ${userFirstName}'s background over inflated claims.`,
          "",
          "## Target Job",
          "",
          `- company: ${row.dataset.company || ""}`,
          `- title: ${row.dataset.title || ""}`,
          `- location: ${row.dataset.location || ""}`,
          `- url: ${row.dataset.url || ""}`,
          `- fit_summary: ${row.dataset.fitSummary || ""}`,
          `- main_requirements: ${row.dataset.requirements || "Not available yet; flag missing requirements before drafting."}`,
          `- network_summary: ${row.dataset.networkSummary || "No network signal available yet."}`,
          `- suggested_first_reaches: ${row.dataset.networkContacts || "No suggested contact available yet."}`,
          `- job_id: ${row.dataset.jobId || ""}`,
          "",
          "## Voice And Structure Profile",
          "",
          "- Cover letters should open by naming the role, the employer, and the practical reason the opportunity fits.",
          applicationContext || "- Use the uploaded resume, cover-letter examples, and style guide as the source of truth.",
          "- The tone should be plainspoken: direct first-person statements, concrete examples, and minimal flourish.",
          "- Paragraphs should move from interest in the organization, to relevant academic/professional background, to specific operating strengths, to a short close.",
          "- Resume bullets should emphasize the user's strongest relevant evidence from the uploaded context.",
          "- Prefer measured confidence over salesy language. The application should sound written by a real person, not a polished AI marketing document.",
          "",
          "## Current Background To Use Carefully",
          "",
          applicationContext || "- Use only the facts supplied in the uploaded resume/context packet.",
          "- Do not overstate finance, engineering, coding, clearance, citizenship, or technical qualifications. If any of those are relevant to the role, handle them carefully and flag uncertainty.",
          "",
          "## Output Format",
          "",
          "Use Markdown with these exact sections:",
          "",
          "### Tailored Resume",
          "",
          `Write a clean one-page resume for ${userFirstName}. Keep bullets concise and accomplishment-oriented. Use the strongest current experience from the uploaded context as the professional anchor.`,
          "",
          "### Cover Letter",
          "",
          "Write a cover letter with a traditional greeting and signoff. Aim for 4 to 5 paragraphs. The letter should be specific to the company and role without sounding overproduced.",
          "",
          "### Tailoring Note",
          "",
          `List 5 to 7 bullets explaining the choices you made, any assumptions, and any missing information ${userFirstName} should verify before applying.`,
          "",
          "### First-Reach Note",
          "",
          `If a suggested contact is available, draft a short LinkedIn message ${userFirstName} could send before applying. Keep it low-pressure, specific to the role/company, and under 90 words.`,
          "",
          "### Downloadable Files",
          "",
          `If this ChatGPT session can create files, also create downloadable .docx files for the tailored resume and cover letter. If file creation is unavailable, format the resume and cover letter cleanly so ${userFirstName} can paste each into a Word document.`
        ].join("\n");
      }

      function openPacketModal(row) {
        packetContext.textContent = `${row.dataset.company || "Company"} / ${row.dataset.title || "Role"}`;
        packetPrompt.textContent = packetPromptForRow(row);
        packetCommand.textContent = packetCommandForRow(row);
        packetModal.classList.add("is-open");
      }

      document.getElementById("close-packet").addEventListener("click", () => packetModal.classList.remove("is-open"));
      async function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.style.position = "fixed";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }
      document.getElementById("open-chatgpt").addEventListener("click", async () => {
        await copyText(packetPrompt.textContent);
        window.open("https://chatgpt.com/g/g-p-6a1f49c34ec481918bc839b79a99932d-job-search/project?tab=chats", "_blank", "noopener,noreferrer");
      });
      document.getElementById("copy-packet-command").addEventListener("click", async () => {
        await copyText(packetCommand.textContent);
      });
      document.getElementById("copy-packet-prompt").addEventListener("click", async () => {
        await copyText(packetPrompt.textContent);
      });

      const cityPanels = Array.from(document.querySelectorAll("[data-city-panel]"));

      function activateCityMarker(panelIndex, markerNode) {
        document.querySelectorAll(".city-marker").forEach((item) => item.classList.toggle("active", item === markerNode));
        cityPanels.forEach((panel) => {
          panel.hidden = panel.dataset.cityPanel !== String(panelIndex);
        });
      }

      async function initJobMarketMap() {
        const wrap = document.getElementById("job-market-map");
        const loading = document.getElementById("job-market-map-loading");
        if (!wrap || !cityMarkets.length) return;
        if (!window.d3 || !window.topojson) {
          if (loading) loading.textContent = "Map library unavailable";
          return;
        }

        const width = wrap.clientWidth || 720;
        const height = Math.round(width * 0.58);
        wrap.querySelectorAll("svg").forEach((node) => node.remove());
        const svg = d3.select(wrap)
          .append("svg")
          .attr("class", "us-map-svg")
          .attr("viewBox", `0 0 ${width} ${height}`)
          .attr("role", "img")
          .attr("aria-label", "United States map of current job markets");
        const projection = d3.geoAlbersUsa().scale(width * 1.18).translate([width / 2, height / 2]);
        const path = d3.geoPath().projection(projection);

        try {
          const us = await d3.json("assets/us-states-10m.json");
          if (loading) loading.remove();
          svg.append("g")
            .selectAll("path")
            .data(topojson.feature(us, us.objects.states).features)
            .join("path")
            .attr("d", path)
            .attr("fill", "#272420")
            .attr("stroke", "#3a3730")
            .attr("stroke-width", 0.7);
          svg.append("path")
            .datum(topojson.mesh(us, us.objects.states, (a, b) => a !== b))
            .attr("fill", "none")
            .attr("stroke", "#3a3730")
            .attr("stroke-width", 0.45)
            .attr("d", path);
        } catch (error) {
          if (loading) loading.textContent = "Map unavailable";
          svg.append("rect").attr("width", width).attr("height", height).attr("fill", "#272420");
        }

        const markerLayer = svg.append("g").attr("class", "city-marker-layer");
        cityMarkets.forEach((city) => {
          const projected = projection([city.longitude, city.latitude]);
          if (!projected) return;
          const [cx, cy] = projected;
          const marker = markerLayer.append("g")
            .attr("class", "city-marker")
            .attr("tabindex", "0")
            .attr("role", "button")
            .attr("aria-label", `${city.label}: ${city.count} open roles`)
            .attr("transform", `translate(${cx},${cy})`);
          marker.append("circle")
            .attr("class", "geo-halo")
            .attr("r", Math.min(18, 9 + city.count));
          marker.append("circle")
            .attr("class", "geo-dot")
            .attr("r", 4);
          const label = `${city.label.toUpperCase()} / ${city.count}`;
          const text = marker.append("text")
            .attr("class", "geo-label")
            .attr("text-anchor", "middle")
            .attr("dominant-baseline", "middle")
            .attr("y", -24)
            .text(label);
          const box = text.node().getBBox();
          marker.insert("rect", "text")
            .attr("class", "geo-label-bg")
            .attr("x", box.x - 9)
            .attr("y", box.y - 4)
            .attr("width", box.width + 18)
            .attr("height", box.height + 8)
            .attr("rx", 10);
          marker.on("click", () => activateCityMarker(city.panelIndex, marker.node()));
          marker.on("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              activateCityMarker(city.panelIndex, marker.node());
            }
          });
        });

        const firstMarker = document.querySelector(".city-marker");
        if (firstMarker && cityMarkets[0]) activateCityMarker(cityMarkets[0].panelIndex, firstMarker);
      }

      initJobMarketMap();

      document.querySelectorAll("[data-analytics-filter]").forEach((button) => {
        button.addEventListener("click", () => {
          const next = {
            type: button.dataset.analyticsFilter,
            value: button.dataset.analyticsValue,
            label: button.closest(".analytics-module")?.querySelector("h3")?.textContent || "Analytics"
          };
          if (
            activeAnalyticsFilter &&
            activeAnalyticsFilter.type === next.type &&
            activeAnalyticsFilter.value === next.value
          ) {
            activeAnalyticsFilter = null;
          } else {
            activeAnalyticsFilter = next;
          }
          applyFilters();
          document.getElementById("analytics-matches")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      if (clearAnalyticsFilterButton) {
        clearAnalyticsFilterButton.addEventListener("click", () => {
          activeAnalyticsFilter = null;
          applyFilters();
        });
      }

      tabButtons.forEach((button) => {
        button.addEventListener("click", () => {
          setActivePanel(button.dataset.tabTarget);
          syncPrimaryNav("this-week");
          syncCategoryTabs(button.dataset.tabTarget);
          saveViewState("this-week", button.dataset.tabTarget);
          applyFilters();
        });
      });

      primaryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const view = button.dataset.primaryView;
          syncPrimaryNav(view);
          if (view === "this-week") {
            const activeCategory = document.querySelector(".quick-filter.active") || tabButtons[0];
            setActivePanel(activeCategory.dataset.tabTarget);
            syncCategoryTabs(activeCategory.dataset.tabTarget);
            saveViewState(view, activeCategory.dataset.tabTarget);
          } else {
            setActivePanel(button.dataset.tabTarget);
            syncCategoryTabs("");
            saveViewState(view, button.dataset.tabTarget);
          }
          applyFilters();
        });
      });

      [scoreFilter, locationFilter, feedbackFilter, textFilter].forEach((control) => control.addEventListener("input", applyFilters));
      document.getElementById("clear-filters").addEventListener("click", () => {
        scoreFilter.value = "0";
        locationFilter.value = "";
        feedbackFilter.value = "";
        textFilter.value = "";
        applyFilters();
      });
      document.getElementById("export-feedback").addEventListener("click", () => {
        const payload = buildCalibrationPayload();
        localStorage.setItem(calibrationPayloadKey, JSON.stringify(payload));
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "job-search-feedback.json";
        link.click();
        URL.revokeObjectURL(url);
      });

      restoreViewState();
      applyFilters();
    </script>
  </body>
</html>
